# Deep Agents CLI Environment Configuration
# 
# IMPORTANT: Copy this file to .env and fill in your actual API keys.
# The .env file is gitignored and should NEVER be committed to version control.
#
# Security Best Practices:
# 1. Never commit this file with real keys
# 2. Rotate keys regularly
# 3. Use separate keys for development and production
# 4. Set spending limits on your API provider account

# ==========================================
# LLM Provider Configuration
# ==========================================

# Format: provider:model (e.g., openai:gpt-4o, anthropic:claude-3-sonnet)
# Default: openai:gpt-4o
DEEPAGENTS_MODEL=openai:gpt-4o

# ==========================================
# Option 1: OpenAI (Default)
# ==========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: change for custom endpoints

# ==========================================
# Option 2: OpenAI-Compatible APIs
# ==========================================
# Use any OpenAI-compatible API endpoint:
# - OpenCode: https://api.opencode.ai/v1
# - Fireworks AI: https://api.fireworks.ai/inference/v1
# - Together AI: https://api.together.xyz/v1
# - LocalAI: http://localhost:8080/v1

# Example for OpenCode:
# OPENAI_API_KEY=your-opencode-api-key
# OPENAI_BASE_URL=https://api.opencode.ai/v1
# DEEPAGENTS_MODEL=openai:gpt-4o

# Example for Fireworks AI:
# OPENAI_API_KEY=your-fireworks-api-key
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
# DEEPAGENTS_MODEL=openai:accounts/fireworks/models/llama-v3p1-70b-instruct

# ==========================================
# Option 3: Anthropic (Claude)
# ==========================================
# Uncomment if you prefer Claude over GPT
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# DEEPAGENTS_MODEL=anthropic:claude-3-sonnet-20240229

# ==========================================
# Application Settings
# ==========================================

# Debug mode (set to true for verbose logging)
# DEEPAGENTS_DEBUG=false

# Default agent name
# DEEPAGENTS_DEFAULT_AGENT=agent

# Session storage path
# DEEPAGENTS_SESSIONS_PATH=~/.deepagents/sessions.db

# ==========================================
# Advanced: Multiple Providers
# ==========================================
# You can configure multiple providers and switch between them
# by changing DEEPAGENTS_MODEL

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# FIREWORKS_API_KEY=fw-...
# 
# Then switch with:
# DEEPAGENTS_MODEL=openai:gpt-4o
# or
# DEEPAGENTS_MODEL=anthropic:claude-3-sonnet
# or
# DEEPAGENTS_MODEL=fireworks:accounts/fireworks/models/llama-v3p1-70b-instruct
